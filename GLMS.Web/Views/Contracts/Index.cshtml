@model IEnumerable<GLMS.Core.Entities.Contract>

<h1>Contracts</h1>

<p>
    <a asp-action="Create">Create New Contract</a>
</p>

<form method="get">

    <div class="row mb-3">

        <div class="col-md-3">
            <label>Status</label>

            <select name="status" class="form-control">

                <option value="">All</option>
                <option value="Draft">Draft</option>
                <option value="Active">Active</option>
                <option value="Expired">Expired</option>
                <option value="OnHold">OnHold</option>

            </select>
        </div>

        <div class="col-md-3">
            <label>Start Date From</label>

            <input type="date"
                   name="startDate"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label>Start Date To</label>

            <input type="date"
                   name="endDate"
                   class="form-control" />
        </div>

        <div class="col-md-3 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

        </div>

    </div>

</form>

<table class="table">
    <thead>
        <tr>
            <th>Client</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>File</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Client?.Name</td>
                <td>@item.StartDate</td>
                <td>@item.EndDate</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.FilePath))
                    {
                        <a href="@item.FilePath" target="_blank">
                            View File
                        </a>
                    }
                    else
                    {
                        <span>No File</span>
                    }
                </td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>