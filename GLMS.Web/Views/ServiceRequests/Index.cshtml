@model IEnumerable<GLMS.Core.Entities.ServiceRequest>

<h1>Service Requests</h1>

<p>
    <a asp-action="Create">
        Create New Request
    </a>
</p>

<table class="table">

    <thead>
        <tr>
            <th>Contract</th>
            <th>Description</th>
            <th>Cost USD</th>
            <th>Cost ZAR</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Contract?.Id</td>
                <td>@item.Description</td>
                <td>@item.CostUSD</td>
                <td>@item.CostZAR</td>
                <td>@item.Status</td>
            </tr>
        }

    </tbody>

</table>
